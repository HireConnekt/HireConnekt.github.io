rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in [
               'jue.george@gmail.com',
               'binoybt@gmail.com',
               'geojins@gmail.com',
               'b.ajaymathews@gmail.com'
             ];
    }

    // Helper: Check if Beta mode is enabled
    function betaIsEnabled() {
      return exists(/databases/$(database)/documents/hireconnect_config/beta_settings)
             && get(/databases/$(database)/documents/hireconnect_config/beta_settings).data.betaEnabled == true;
    }

    // Helper: Check if user has valid creator invite with quota remaining
    function hasCreatorInvite() {
      return request.auth != null
             && exists(/databases/$(database)/documents/beta_creator_invites/$(request.auth.token.email))
             && get(/databases/$(database)/documents/beta_creator_invites/$(request.auth.token.email)).data.isActive == true
             && get(/databases/$(database)/documents/beta_creator_invites/$(request.auth.token.email)).data.groupsCreated
                < get(/databases/$(database)/documents/beta_creator_invites/$(request.auth.token.email)).data.groupsAllowed;
    }

    // BETA: Waitlist for group creation requests
    match /beta_waitlist/{requestId} {
      // Anyone signed in can create a waitlist request for themselves
      allow create: if request.auth != null
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.status == 'pending';

      // Users can read their own request
      allow read: if request.auth != null
                  && resource.data.email == request.auth.token.email;

      // Only admins can update, delete, or list all
      allow update, delete: if isAdmin();
      allow list: if isAdmin();
    }

    // BETA: Creator invites (admin-granted group creation rights)
    match /beta_creator_invites/{email} {
      // Anyone signed in can read their own invite status
      allow read: if request.auth != null
                  && request.auth.token.email == email;

      // Only admins can create/update/delete invites
      allow create: if isAdmin()
                    && request.resource.data.email == email;

      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Admins can list all invites
      allow list: if isAdmin();
    }

    // HIRECONNECT: Groups (Beta-gated creation)
    match /hireconnect_groups/{groupId} {
      // Create: Either Beta is disabled OR user has active creator invite with quota
      allow create: if request.auth != null
                    && (!betaIsEnabled() || hasCreatorInvite());

      // Read: Any signed-in user (needed for invite code lookup)
      allow read: if request.auth != null;

      // Update: Only admins for now (will add group admin check later)
      allow update: if isAdmin();
    }

    // HIRECONNECT: Memberships
    match /hireconnect_memberships/{membershipId} {
      // Create: User can join as member (via invite), or as admin when creating group
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && (
                      request.resource.data.role == 'member'
                      || (request.resource.data.role == 'admin'
                          && request.resource.data.joinMethod == 'created')
                    );

      // Read: User can read their own
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      // Update/Delete: Only admins for now
      allow update, delete: if isAdmin();
    }    
   
    // Slots - everyone can read and write (existing)
    match /slots/{slotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
   
    // User Preferences (existing)
    match /userPreferences/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
   
    // Slots Backup - Admin only (existing)
    match /slots_backup/{backupId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
   
    //  NEW: Blocked Days - Admin write, everyone read
    match /blockedDays/{dayId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
   
    //  NEW: Blocked Slots - Admin write, everyone read
    match /blockedSlots/{slotId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Events - Public read, admin write
    match /events/{eventId} {
       allow read: if true;
       allow create, update, delete: if isAdmin();
   }
    
    // HIRECONNECT DB Entries
    
    match /hireconnect_requests/{docId} {
      allow read: if true;
      allow create: if request.resource.data.status == "open"
        && request.resource.data.keys().hasAll(["jobUrl","company","submittedAt","status"]);
      allow update: if request.auth != null
         && resource.data.status == "open"
         && request.resource.data.status == "resolved";
      allow delete: if false;
    }
    
    match /hireconnect_connectors/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
      request.auth.uid == uid ||
      request.auth.token.email in get(/databases/$(database)/documents/hireconnect_config/admins).data.emails
       );
    }
    
    match /hireconnect_config/{doc} {
      allow read: if request.auth != null;
      // Allow admins to write to config (needed for beta_settings)
      allow write: if isAdmin();
    }
  }
}